# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin panel kill switch (set true to disable admin routes)
VITE_ADMIN_DISABLED=false

# Dev seed helper (shows test login button when true)
VITE_DEV_SEED_ENABLED=true

# Service role — NEVER expose to client; edge functions only
# SUPABASE_SERVICE_ROLE_KEY=
